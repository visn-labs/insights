VISN_BIND=127.0.0.1:8080
VISN_DATA_DIR=./data
VISN_MAX_UPLOAD_MB=2048
VISN_LOG=visn_phase0=info,tower_http=info

# LM Studio endpoints. The native API is used to load the selected VLM.
VISN_GEMMA_BASE_URL=http://127.0.0.1:1234/v1
VISN_LMSTUDIO_API_BASE_URL=http://127.0.0.1:1234/api/v1
VISN_GEMMA_MODEL=
VISN_GEMMA_API_KEY=lm-studio
VISN_GEMMA_TIMEOUT_SECS=120
# Bound LM Studio's active context and generation footprint. These are applied
# when this service loads a model through LM Studio's native API.
VISN_VLM_CONTEXT_LENGTH=4096
VISN_VLM_EVAL_BATCH_SIZE=256
VISN_VLM_MAX_OUTPUT_TOKENS=768
VISN_VLM_FLASH_ATTENTION=true
VISN_VLM_OFFLOAD_KV_CACHE_TO_GPU=false
# Avoid detector/observer model memory and CPU load overlapping a large VLM.
VISN_VLM_EXCLUSIVE_MEDIA=true

# Optional local YOLO26 development runner.
# Optional override; .venv/bin/python is selected automatically when present.
VISN_DETECTOR_EXECUTABLE=.venv/bin/python
VISN_DETECTOR_ARGS=tools/yolo26_runner.py
VISN_MEMORY_RUNNER_ARGS=tools/event_memory_runner.py
VISN_YOLO_MODEL=yolo26s.pt
# Prevent N camera processes from each claiming every CPU core. Person
# appearance is sampled periodically; the first sighting is always retained.
VISN_DETECTOR_THREADS=1
VISN_APPEARANCE_INTERVAL_SECS=1.0
# Upper bound accepted by the per-job monitor_duration_secs field.
VISN_MAX_ANALYSIS_SECS=3600
VISN_MAX_CLUSTER_CAMERAS=16
VISN_MAX_CONCURRENT_CAMERAS=4
# Completed non-persistent jobs kept in RAM for the test API/UI.
VISN_MAX_EPHEMERAL_JOBS=128
# Retrieval-memory bounds. The VLM cap applies independently to each camera.
VISN_MAX_MEMORY_EVENTS_PER_CAMERA=48
VISN_MAX_VLM_EVENTS_PER_CAMERA=8
# copy: stream-copy each event when possible, then transcode only as fallback.
# transcode: always create a browser-oriented H.264 clip.
# reference: retain only the source evidence (lowest CPU/disk; clip URL opens it).
VISN_MEMORY_CLIP_MODE=copy

# Kafka is disabled unless compiled with --features kafka and explicitly enabled.
VISN_KAFKA_ENABLED=false
VISN_KAFKA_BROKERS=127.0.0.1:9092
VISN_KAFKA_EVENT_TOPIC=event.observed.v1
VISN_KAFKA_REPORT_TOPIC=insight.completed.v1
