VISN_BIND=127.0.0.1:8080
VISN_DATA_DIR=./data
VISN_MAX_UPLOAD_MB=2048
VISN_LOG=visn_phase0=info,tower_http=info

# LM Studio OpenAI-compatible endpoint. Model is auto-discovered when omitted.
VISN_GEMMA_BASE_URL=http://127.0.0.1:1234/v1
VISN_GEMMA_MODEL=
VISN_GEMMA_API_KEY=lm-studio
VISN_GEMMA_TIMEOUT_SECS=120

# Optional local YOLO26 development runner.
# Optional override; .venv/bin/python is selected automatically when present.
VISN_DETECTOR_EXECUTABLE=.venv/bin/python
VISN_DETECTOR_ARGS=tools/yolo26_runner.py
VISN_YOLO_MODEL=yolo26s.pt
# Upper bound accepted by the per-job monitor_duration_secs field.
VISN_MAX_ANALYSIS_SECS=3600

# Kafka is disabled unless compiled with --features kafka and explicitly enabled.
VISN_KAFKA_ENABLED=false
VISN_KAFKA_BROKERS=127.0.0.1:9092
VISN_KAFKA_EVENT_TOPIC=event.observed.v1
VISN_KAFKA_REPORT_TOPIC=insight.completed.v1
